---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<div class="footer-logo">
				<div class="footer-monogram">RS</div>

				<div class="footer-divider"></div>

				<div>
					<div class="footer-name">RAYMOND SOLOMON</div>
					<div class="footer-title">SENIOR FINANCIAL ADVISOR</div>
				</div>
			</div>
		</div>

		<div class="footer-links">
			<a href="/">Home</a>
			<a href="/about">About</a>
			<a href="/#markets">Markets</a>
			<a href="/#contact">Contact</a>
		</div>

		<div class="footer-disclaimer">
			Information on this website is for general informational purposes only
			and does not constitute investment advice or a recommendation to buy
			or sell any financial instrument. Past performance is not indicative
			of future results.
		</div>
	</div>

	<div class="footer-bottom">
		<div>
			© {today.getFullYear()} Raymond Solomon. All rights reserved.
		</div>

		<div>
			UK Based · Senior Financial Advisor
		</div>
	</div>
</footer>

<style>
	footer {
		background: #080a0e;
		border-top: 1px solid rgba(196, 157, 78, 0.55);
		color: #f4f0e8;
		padding: 48px 24px 24px;
	}

	.footer-inner {
		max-width: 1250px;
		margin: 0 auto;

		display: grid;
		grid-template-columns: 1.4fr 1fr 1.4fr;
		align-items: start;
		gap: 60px;

		padding-bottom: 42px;
	}

	.footer-logo {
		display: flex;
		align-items: center;
	}

	.footer-monogram {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 36px;
		line-height: 1;
		color: #c49d4e;
		letter-spacing: -4px;
		width: 52px;
	}

	.footer-divider {
		width: 1px;
		height: 42px;
		background: rgba(255, 255, 255, 0.2);
		margin: 0 20px 0 16px;
	}

	.footer-name {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 16px;
		letter-spacing: 4px;
		color: #c49d4e;
	}

	.footer-title {
		margin-top: 7px;
		color: #8d9198;
		font-size: 9px;
		letter-spacing: 3px;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 30px;
		padding-top: 9px;
	}

	.footer-links a {
		color: #c9c5bd;
		text-decoration: none;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		transition: color 0.2s ease;
	}

	.footer-links a:hover {
		color: #c49d4e;
	}

	.footer-disclaimer {
		color: #777d86;
		font-size: 11px;
		line-height: 1.7;
	}

	.footer-bottom {
		max-width: 1250px;
		margin: 0 auto;

		padding-top: 20px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);

		display: flex;
		justify-content: space-between;
		gap: 20px;

		color: #626872;
		font-size: 10px;
		letter-spacing: 0.5px;
	}

	@media (max-width: 900px) {
		.footer-inner {
			grid-template-columns: 1fr 1fr;
		}

		.footer-disclaimer {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 650px) {
		footer {
			padding: 40px 20px 20px;
		}

		.footer-inner {
			grid-template-columns: 1fr;
			gap: 30px;
		}

		.footer-disclaimer {
			grid-column: auto;
		}

		.footer-links {
			flex-wrap: wrap;
			gap: 18px;
		}

		.footer-bottom {
			flex-direction: column;
		}
	}
</style>
