---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">Raymond Solomon</a>
		</h2>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/about#contact">Contact</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 24px;
		background: #080a0e;
		border-bottom: 1px solid rgba(196, 157, 78, 0.18);
	}

	nav {
		max-width: 1050px;
		margin: 0 auto;
		min-height: 76px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	h2 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 21px;
		font-weight: 600;
		letter-spacing: -0.2px;
	}

	h2 a {
		color: #f4f0e8;
		text-decoration: none;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.internal-links a {
		position: relative;
		padding: 12px 14px;
		color: #c9c5bd;
		text-decoration: none;
		font-size: 14px;
		letter-spacing: 0.2px;
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	.internal-links a:hover {
		color: #c49d4e;
	}

	@media (max-width: 600px) {
		header {
			padding: 0 18px;
		}

		nav {
			min-height: 68px;
		}

		h2 {
			font-size: 18px;
		}

		.internal-links {
			gap: 0;
		}

		.internal-links a {
			padding: 10px 7px;
			font-size: 13px;
		}
	}
</style>
