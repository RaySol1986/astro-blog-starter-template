---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">Raymond Solomon</a></h2>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/about#contact">Contact</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 24px;
		background: white;
		border-bottom: 1px solid #e5e7eb;
	}

	nav {
		max-width: 1050px;
		margin: 0 auto;
		min-height: 72px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	h2 {
		margin: 0;
		font-size: 18px;
	}

	h2 a {
		color: #172033;
		text-decoration: none;
		font-weight: 700;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.internal-links a {
		padding: 12px 14px;
		color: #172033;
		text-decoration: none;
		font-size: 15px;
	}

	.internal-links a:hover {
		color: #8a6a2f;
	}

	@media (max-width: 600px) {
		nav {
			min-height: 64px;
		}

		h2 {
			font-size: 16px;
		}

		.internal-links a {
			padding: 10px 7px;
			font-size: 14px;
		}
	}
</style>
