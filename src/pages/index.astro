---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<style>
			:global(*) {
				box-sizing: border-box;
			}

			:global(html) {
				scroll-behavior: smooth;
				background: #080a0e;
			}

			:global(body) {
				margin: 0;
				background: #080a0e;
				color: #f4f0e8;
				font-family: Arial, Helvetica, sans-serif;
			}

			.page {
				background: #080a0e;
			}

			/* =========================
			   HERO
			========================= */

			.hero {
				position: relative;
				min-height: 540px;
				border-bottom: 1px solid rgba(196, 157, 78, 0.65);
				overflow: hidden;
				background: #080a0e;
			}

			.hero-image {
				position: absolute;
				inset: 0 0 0 45%;
				background:
					linear-gradient(
						90deg,
						#080a0e 0%,
						rgba(8, 10, 14, 0.92) 8%,
						rgba(8, 10, 14, 0.35) 48%,
						rgba(8, 10, 14, 0.2) 100%
					),
					url('/london-night.jpg') center center / cover no-repeat;
			}

			.hero-image::after {
				content: '';
				position: absolute;
				inset: 0;
				background: rgba(8, 10, 14, 0.2);
			}

			.hero-inner {
				position: relative;
				z-index: 2;
				max-width: 1050px;
				min-height: 540px;
				margin: 0 auto;
				display: flex;
				align-items: center;
			}

			.hero-content {
				width: 58%;
				padding: 70px 30px 70px 0;
			}

			.eyebrow {
				margin-bottom: 18px;
				color: #c49d4e;
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 2px;
				text-transform: uppercase;
			}

			h1 {
				max-width: 610px;
				margin: 0;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: clamp(58px, 6.5vw, 88px);
				font-weight: 400;
				line-height: 0.95;
				letter-spacing: -3px;
				color: #f4f0e8;
			}

			h1 .gold {
				color: #c49d4e;
			}

			.hero-line {
				width: 56px;
				height: 2px;
				margin: 28px 0 24px;
				background: #c49d4e;
			}

			.hero-description {
				max-width: 520px;
				margin: 0 0 30px;
				color: #c9c5bd;
				font-size: 16px;
				line-height: 1.8;
			}

			.cta {
				display: inline-block;
				padding: 16px 29px;
				background: #c49d4e;
				border: 1px solid #c49d4e;
				color: #080a0e;
				text-decoration: none;
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 1px;
				text-transform: uppercase;
				transition: all 0.2s ease;
			}

			.cta:hover {
				background: #d5b56f;
				border-color: #d5b56f;
			}

			/* Decorative diagonal lines */

			.hero-diagonal {
				position: absolute;
				z-index: 3;
				top: -50px;
				bottom: -50px;
				left: 48%;
				width: 2px;
				background: rgba(196, 157, 78, 0.42);
				transform: rotate(18deg);
				transform-origin: center;
			}

			.hero-diagonal.two {
				left: calc(48% + 18px);
				opacity: 0.35;
			}

			/* =========================
			   CREDIBILITY BAR
			========================= */

			.stats {
				border-bottom: 1px solid rgba(196, 157, 78, 0.55);
				background: #080a0e;
			}

			.stats-inner {
				max-width: 1050px;
				margin: 0 auto;
				display: grid;
				grid-template-columns: repeat(4, 1fr);
			}

			.stat {
				min-height: 105px;
				padding: 22px 25px;
				display: flex;
				align-items: center;
				gap: 16px;
				border-right: 1px solid rgba(255, 255, 255, 0.1);
			}

			.stat:last-child {
				border-right: none;
			}

			.stat-icon {
				color: #c49d4e;
				font-size: 28px;
				width: 35px;
				text-align: center;
			}

			.stat-number {
				color: #c49d4e;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 30px;
				line-height: 1;
			}

			.stat-label {
				margin-top: 7px;
				color: #b9b5ae;
				font-size: 10px;
				letter-spacing: 1.5px;
				text-transform: uppercase;
			}

			/* =========================
			   INTRO
			========================= */

			.intro {
				padding: 100px 24px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.07);
			}

			.intro-inner {
				max-width: 850px;
				margin: 0 auto;
				text-align: center;
			}

			.intro h2 {
				margin: 0 0 24px;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: clamp(38px, 5vw, 58px);
				font-weight: 400;
				line-height: 1.05;
				color: #f4f0e8;
			}

			.intro p {
				max-width: 680px;
				margin: 0 auto;
				color: #aaa7a1;
				font-size: 17px;
				line-height: 1.8;
			}

			/* =========================
			   MARKETS
			========================= */

			.markets-section {
				padding: 90px 24px;
				background: #0b0e13;
				border-bottom: 1px solid rgba(255, 255, 255, 0.07);
			}

			.markets-inner {
				max-width: 1050px;
				margin: 0 auto;
			}

			.section-heading {
				margin-bottom: 45px;
			}

			.section-heading h2 {
				margin: 0;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: clamp(40px, 5vw, 58px);
				font-weight: 400;
				color: #f4f0e8;
			}

			.market-grid {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				border-top: 1px solid rgba(196, 157, 78, 0.35);
				border-left: 1px solid rgba(255, 255, 255, 0.08);
			}

			.market {
				min-height: 150px;
				padding: 30px 22px;
				display: flex;
				align-items: flex-end;
				border-right: 1px solid rgba(255, 255, 255, 0.08);
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				transition: background 0.25s ease;
			}

			.market:hover {
				background: #11151c;
			}

			.market span {
				color: #f4f0e8;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 25px;
			}

			/* =========================
			   CONTACT
			========================= */

			.contact {
				padding: 105px 24px;
				text-align: center;
				border-bottom: 1px solid rgba(196, 157, 78, 0.45);
			}

			.contact-inner {
				max-width: 760px;
				margin: 0 auto;
			}

			.contact h2 {
				margin: 0 0 22px;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: clamp(44px, 6vw, 68px);
				font-weight: 400;
				line-height: 1;
				color: #f4f0e8;
			}

			.contact p {
				max-width: 600px;
				margin: 0 auto 32px;
				color: #aaa7a1;
				font-size: 17px;
				line-height: 1.8;
			}

			/* =========================
			   MOBILE
			========================= */

			@media (max-width: 800px) {
				.hero {
					min-height: auto;
				}

				.hero-image {
					inset: 0;
					opacity: 0.35;
				}

				.hero-inner {
					min-height: auto;
				}

				.hero-content {
					width: 100%;
					padding: 80px 24px;
				}

				.hero-diagonal {
					display: none;
				}

				h1 {
					font-size: clamp(52px, 15vw, 76px);
					letter-spacing: -2px;
				}

				.stats-inner {
					grid-template-columns: repeat(2, 1fr);
				}

				.stat:nth-child(2) {
					border-right: none;
				}

				.stat:nth-child(-n + 2) {
					border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				}

				.market-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (max-width: 500px) {
				.stats-inner,
				.market-grid {
					grid-template-columns: 1fr;
				}

				.stat {
					border-right: none;
					border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				}

				.stat:last-child {
					border-bottom: none;
				}

				.market {
					min-height: 110px;
				}
			}
		</style>
	</head>

	<body>
		<div class="page">
			<Header />

			<main>
				<!-- HERO -->

				<section class="hero">
					<div class="hero-image"></div>

					<div class="hero-diagonal"></div>
					<div class="hero-diagonal two"></div>

					<div class="hero-inner">
						<div class="hero-content">
							<div class="eyebrow">Senior Financial Advisor</div>

							<h1>
								Experience.<br />
								Discipline.<br />
								<span class="gold">Market Insight.</span>
							</h1>

							<div class="hero-line"></div>

							<p class="hero-description">
								Raymond Solomon brings 20 years of experience
								navigating global financial markets, with a
								disciplined approach to research, risk and
								market opportunity.
							</p>

							<a class="cta" href="#contact">
								Request a Consultation
							</a>
						</div>
					</div>
				</section>

				<!-- CREDIBILITY -->

				<section class="stats">
					<div class="stats-inner">
						<div class="stat">
							<div class="stat-icon">◷</div>
							<div>
								<div class="stat-number">20+</div>
								<div class="stat-label">Years Experience</div>
							</div>
						</div>

						<div class="stat">
							<div class="stat-icon">◎</div>
							<div>
								<div class="stat-number">5</div>
								<div class="stat-label">Market Areas</div>
							</div>
						</div>

						<div class="stat">
							<div class="stat-icon">♜</div>
							<div>
								<div class="stat-number">UK</div>
								<div class="stat-label">Based in London</div>
							</div>
						</div>

						<div class="stat">
							<div class="stat-icon">↗</div>
							<div>
								<div class="stat-number">Disciplined</div>
								<div class="stat-label">Research Driven</div>
							</div>
						</div>
					</div>
				</section>

				<!-- INTRO -->

				<section class="intro">
					<div class="intro-inner">
						<div class="eyebrow">The Approach</div>

						<h2>
							Experience built through
							different market cycles.
						</h2>

						<p>
							With two decades of experience across global
							financial markets, my approach is centred on
							research, discipline, risk awareness and a
							clear understanding of changing market conditions.
						</p>
					</div>
				</section>

				<!-- MARKETS -->

				<section class="markets-section" id="markets">
					<div class="markets-inner">
						<div class="section-heading">
							<div class="eyebrow">Market Coverage</div>

							<h2>Global Markets</h2>
						</div>

						<div class="market-grid">
							<div class="market">
								<span>Stocks</span>
							</div>

							<div class="market">
								<span>Commodities</span>
							</div>

							<div class="market">
								<span>Forex</span>
							</div>

							<div class="market">
								<span>Metals</span>
							</div>

							<div class="market">
								<span>Crypto</span>
							</div>
						</div>
					</div>
				</section>

				<!-- CONTACT -->

				<section class="contact" id="contact">
					<div class="contact-inner">
						<div class="eyebrow">Private Consultation</div>

						<h2>Let's start a conversation.</h2>

						<p>
							If you would like to discuss your objectives
							or learn more about my approach to the markets,
							get in touch.
						</p>

						<a class="cta" href="/about#contact">
							Request a Consultation
						</a>
					</div>
				</section>
			</main>

			<Footer />
		</div>
	</body>
</html>
