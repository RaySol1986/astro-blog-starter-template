---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Raymond Solomon | Senior Financial Advisor</title>
		<meta
			name="description"
			content="Raymond Solomon is a Senior Financial Advisor with 20 years of experience navigating global financial markets."
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="hero">
				<div class="hero-inner">
					<div class="hero-content">
						<div class="eyebrow">SENIOR FINANCIAL ADVISOR</div>

						<h1>
							<span>Experience.</span>
							<span>Discipline.</span>
							<strong>Market Insight.</strong>
						</h1>

						<div class="gold-line"></div>

						<p class="hero-description">
							Raymond Solomon brings 20 years of experience navigating global
							financial markets, with a disciplined approach to research, risk
							and market opportunity.
						</p>

						<a class="hero-button" href="/about#contact">
							REQUEST A CONSULTATION
						</a>
					</div>

					<div class="hero-image">
						<img
							src="/LondonBG.png"
							alt="London financial district at night"
						/>
						<div class="image-overlay"></div>
					</div>
				</div>
			</section>

			<!-- STATS -->
			<section class="stats">
				<div class="stats-inner">
					<div class="stat">
						<div class="stat-number">20+</div>
						<div>
							<div class="stat-heading">YEARS</div>
							<div class="stat-heading">EXPERIENCE</div>
							<div class="stat-small">PROFESSIONAL MARKET EXPERIENCE</div>
						</div>
					</div>

					<div class="stat">
						<div class="stat-number">5</div>
						<div>
							<div class="stat-heading">MARKET</div>
							<div class="stat-heading">AREAS</div>
							<div class="stat-small">GLOBAL MARKETS FOLLOWED</div>
						</div>
					</div>

					<div class="stat">
						<div class="stat-number">UK</div>
						<div>
							<div class="stat-heading">BASED IN</div>
							<div class="stat-heading">LONDON</div>
							<div class="stat-small">UK FINANCIAL MARKETS</div>
						</div>
					</div>

					<div class="stat">
						<div class="diamond"></div>
						<div>
							<div class="stat-heading">DISCIPLINED</div>
							<div class="stat-small">RESEARCH DRIVEN</div>
						</div>
					</div>
				</div>
			</section>

			<!-- INTRO -->
			<section class="intro">
				<div class="intro-inner">
					<div class="intro-label">MARKET PERSPECTIVE</div>

					<h2>
						Clarity in complex<br />
						financial markets.
					</h2>

					<p>
						A research-led approach focused on understanding markets,
						managing risk and identifying opportunities through changing
						economic conditions.
					</p>

					<a href="/about" class="text-link">
						LEARN MORE ABOUT RAYMOND
						<span>→</span>
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #080a0e;
	}

	:global(body) {
		margin: 0;
		background: #080a0e;
		color: #f4f0e8;
		font-family: Arial, Helvetica, sans-serif;
	}

	.hero {
		background: #080a0e;
		padding: 70px 24px 0;
	}

	.hero-inner {
		max-width: 1250px;
		min-height: 610px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 48% 52%;
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid rgba(196, 157, 78, 0.5);
	}

	.hero-content {
		position: relative;
		z-index: 3;
		padding: 55px 55px 70px 20px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background: #080a0e;
	}

	.eyebrow {
		color: #c49d4e;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 2.5px;
		margin-bottom: 24px;
	}

	h1 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(58px, 5.2vw, 82px);
		font-weight: 400;
		line-height: 0.98;
		letter-spacing: -3px;
	}

	h1 span,
	h1 strong {
		display: block;
	}

	h1 span {
		color: #f4f0e8;
	}

	h1 strong {
		color: #c49d4e;
		font-weight: 400;
	}

	.gold-line {
		width: 52px;
		height: 2px;
		background: #c49d4e;
		margin: 30px 0 25px;
	}

	.hero-description {
		max-width: 570px;
		margin: 0;
		color: #c9c5bd;
		font-size: 16px;
		line-height: 1.8;
	}

	.hero-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		margin-top: 32px;
		padding: 17px 30px;
		background: #c49d4e;
		color: #080a0e;
		text-decoration: none;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 1.5px;
		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}

	.hero-button:hover {
		background: #d5b466;
		transform: translateY(-2px);
	}

	.hero-image {
		position: relative;
		min-height: 610px;
		overflow: hidden;
	}

	.hero-image img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center;
		filter: brightness(0.68) contrast(1.08);
	}

	.image-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				90deg,
				#080a0e 0%,
				rgba(8, 10, 14, 0.25) 15%,
				rgba(8, 10, 14, 0.05) 100%
			),
			linear-gradient(
				0deg,
				rgba(8, 10, 14, 0.35),
				transparent 45%
			);
	}

	/* STATS */

	.stats {
		background: #080a0e;
		padding: 0 24px;
	}

	.stats-inner {
		max-width: 1250px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border-bottom: 1px solid rgba(196, 157, 78, 0.45);
	}

	.stat {
		min-height: 115px;
		display: flex;
		align-items: center;
		gap: 22px;
		padding: 25px 30px;
		border-right: 1px solid rgba(255, 255, 255, 0.12);
	}

	.stat:first-child {
		border-left: 1px solid rgba(255, 255, 255, 0.12);
	}

	.stat-number {
		flex-shrink: 0;
		font-family: Georgia, "Times New Roman", serif;
		color: #c49d4e;
		font-size: 30px;
	}

	.stat-heading {
		color: #f4f0e8;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1.5px;
		line-height: 1.5;
	}

	.stat-small {
		max-width: 130px;
		margin-top: 5px;
		color: #737985;
		font-size: 9px;
		line-height: 1.5;
		letter-spacing: 1px;
	}

	.diamond {
		width: 14px;
		height: 14px;
		flex-shrink: 0;
		background: #c49d4e;
		transform: rotate(45deg);
	}

	/* INTRO */

	.intro {
		padding: 130px 24px;
		background: #080a0e;
	}

	.intro-inner {
		max-width: 900px;
		margin: 0 auto;
	}

	.intro-label {
		color: #c49d4e;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 2.5px;
		margin-bottom: 22px;
	}

	.intro h2 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(42px, 5vw, 68px);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -2px;
	}

	.intro p {
		max-width: 600px;
		margin: 30px 0;
		color: #aaa7a1;
		font-size: 16px;
		line-height: 1.8;
	}

	.text-link {
		color: #c49d4e;
		text-decoration: none;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1.5px;
	}

	.text-link span {
		margin-left: 10px;
		font-size: 16px;
	}

	@media (max-width: 900px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}

		.hero-content {
			padding: 65px 40px;
		}

		.hero-image {
			min-height: 430px;
		}

		.stats-inner {
			grid-template-columns: repeat(2, 1fr);
		}

		.stat:nth-child(3),
		.stat:nth-child(4) {
			border-top: 1px solid rgba(255, 255, 255, 0.12);
		}
	}

	@media (max-width: 600px) {
		.hero {
			padding: 30px 16px 0;
		}

		.hero-content {
			padding: 50px 10px;
		}

		h1 {
			font-size: 54px;
			letter-spacing: -2px;
		}

		.hero-description {
			font-size: 15px;
		}

		.hero-image {
			min-height: 330px;
		}

		.stats {
			padding: 0 16px;
		}

		.stats-inner {
			grid-template-columns: 1fr;
		}

		.stat {
			border-left: 0 !important;
			border-right: 0;
			border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		}

		.intro {
			padding: 90px 24px;
		}
	}
</style>
