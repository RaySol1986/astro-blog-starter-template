---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<style>
			:global(html) {
				scroll-behavior: smooth;
			}

			:global(body) {
				margin: 0;
				font-family: Arial, Helvetica, sans-serif;
				color: #f4f0e8;
				background: #080a0e;
			}

			:global(*) {
				box-sizing: border-box;
			}

			:global(a) {
				-webkit-tap-highlight-color: transparent;
			}

			.page {
				background:
					radial-gradient(
						circle at 75% 15%,
						rgba(196, 157, 78, 0.045),
						transparent 28%
					),
					#080a0e;
			}

			/* --------------------------------
			   HERO
			-------------------------------- */

			.hero {
				position: relative;
				min-height: 650px;
				overflow: hidden;
				border-bottom: 1px solid rgba(196, 157, 78, 0.55);
				background: #080a0e;
			}

			.hero-image {
				position: absolute;
				inset: 0 0 0 48%;
				background-image:
					linear-gradient(
						90deg,
						#080a0e 0%,
						rgba(8, 10, 14, 0.96) 9%,
						rgba(8, 10, 14, 0.58) 35%,
						rgba(8, 10, 14, 0.15) 100%
					),
					linear-gradient(
						180deg,
						rgba(8, 10, 14, 0.08),
						rgba(8, 10, 14, 0.38)
					),
					url('/LondonBG.png');

				background-size: cover;
				background-position: center;
				background-repeat: no-repeat;
			}

			.hero::after {
				content: '';
				position: absolute;
				inset: 0;
				pointer-events: none;
				background:
					linear-gradient(
						115deg,
						transparent 0 48%,
						rgba(196, 157, 78, 0.18) 48.1%,
						transparent 48.35%
					);
			}

			.hero-inner {
				position: relative;
				z-index: 2;
				width: min(1250px, calc(100% - 48px));
				min-height: 650px;
				margin: 0 auto;
				display: flex;
				align-items: center;
			}

			.hero-content {
				width: min(590px, 100%);
				padding: 80px 0;
			}

			.eyebrow {
				margin-bottom: 20px;
				color: #c49d4e;
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 2.4px;
				text-transform: uppercase;
			}

			h1 {
				margin: 0;
				max-width: 620px;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: clamp(58px, 6vw, 82px);
				font-weight: 400;
				line-height: 0.98;
				letter-spacing: -3px;
				color: #f4f0e8;
			}

			h1 .gold {
				color: #c49d4e;
			}

			.hero-rule {
				width: 56px;
				height: 2px;
				margin: 30px 0 24px;
				background: #c49d4e;
			}

			.hero-description {
				max-width: 530px;
				margin: 0 0 30px;
				color: #d0cbc3;
				font-size: 17px;
				line-height: 1.75;
			}

			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 50px;
				padding: 0 30px;
				background: #c49d4e;
				border: 1px solid #c49d4e;
				color: #080a0e;
				text-decoration: none;
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 1.4px;
				text-transform: uppercase;
				transition:
					background 0.2s ease,
					color 0.2s ease,
					transform 0.2s ease;
			}

			.button:hover {
				background: #d5b568;
				border-color: #d5b568;
				transform: translateY(-1px);
			}

			/* --------------------------------
			   STATS
			-------------------------------- */

			.stats {
				border-bottom: 1px solid rgba(196, 157, 78, 0.38);
				background: #0b0e13;
			}

			.stats-inner {
				width: min(1050px, calc(100% - 48px));
				margin: 0 auto;
				display: grid;
				grid-template-columns: repeat(4, 1fr);
			}

			.stat {
				min-height: 105px;
				padding: 22px 28px;
				display: flex;
				align-items: center;
				gap: 18px;
				border-right: 1px solid rgba(255, 255, 255, 0.12);
			}

			.stat:last-child {
				border-right: none;
			}

			.stat-number {
				flex-shrink: 0;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 30px;
				color: #c49d4e;
			}

			.stat-label strong {
				display: block;
				margin-bottom: 5px;
				color: #f4f0e8;
				font-size: 11px;
				letter-spacing: 1.5px;
				text-transform: uppercase;
			}

			.stat-label span {
				display: block;
				color: #777d87;
				font-size: 10px;
				line-height: 1.5;
				letter-spacing: 1px;
				text-transform: uppercase;
			}

			/* --------------------------------
			   GENERAL SECTIONS
			-------------------------------- */

			.section {
				padding: 105px 24px;
			}

			.section-inner {
				width: min(1050px, 100%);
				margin: 0 auto;
			}

			.section-heading {
				max-width: 700px;
				margin-bottom: 50px;
			}

			h2 {
				margin: 0;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: clamp(38px, 5vw, 56px);
				font-weight: 400;
				line-height: 1.05;
				letter-spacing: -1.5px;
				color: #f4f0e8;
			}

			.section-intro {
				margin: 20px 0 0;
				color: #9b9ea5;
				font-size: 17px;
				line-height: 1.75;
			}

			/* --------------------------------
			   ABOUT
			-------------------------------- */

			.about {
				background: #080a0e;
			}

			.about-grid {
				display: grid;
				grid-template-columns: 1fr 0.82fr;
				gap: 90px;
				align-items: center;
			}

			.about-copy p {
				margin: 0 0 22px;
				color: #b4b2ae;
				font-size: 16px;
				line-height: 1.85;
			}

			.about-copy p:last-child {
				margin-bottom: 0;
			}

			.about-photo {
				position: relative;
				min-height: 500px;
				background: #11151c;
				border: 1px solid rgba(196, 157, 78, 0.3);
				overflow: hidden;
			}

			.about-photo img {
				display: block;
				width: 100%;
				height: 500px;
				object-fit: cover;
				object-position: center;
				filter: saturate(0.72) contrast(1.04);
			}

			.about-photo::after {
				content: '';
				position: absolute;
				inset: 14px;
				border: 1px solid rgba(196, 157, 78, 0.35);
				pointer-events: none;
			}

			.photo-caption {
				position: absolute;
				z-index: 2;
				left: 25px;
				bottom: 24px;
				padding: 10px 14px;
				background: rgba(8, 10, 14, 0.86);
				border-left: 2px solid #c49d4e;
				color: #f4f0e8;
				font-size: 10px;
				font-weight: 700;
				letter-spacing: 1.8px;
				text-transform: uppercase;
			}

			/* --------------------------------
			   MARKETS
			-------------------------------- */

			.markets {
				background: #0b0e13;
				border-top: 1px solid rgba(255, 255, 255, 0.04);
				border-bottom: 1px solid rgba(255, 255, 255, 0.04);
			}

			.market-grid {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				border-top: 1px solid rgba(196, 157, 78, 0.3);
				border-left: 1px solid rgba(255, 255, 255, 0.08);
			}

			.market {
				min-height: 150px;
				padding: 30px 25px;
				border-right: 1px solid rgba(255, 255, 255, 0.08);
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				transition:
					background 0.2s ease,
					border-color 0.2s ease;
			}

			.market:hover {
				background: #10141b;
				border-color: rgba(196, 157, 78, 0.3);
			}

			.market-number {
				margin-bottom: 30px;
				color: #c49d4e;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 16px;
			}

			.market h3 {
				margin: 0 0 8px;
				color: #f4f0e8;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 24px;
				font-weight: 400;
			}

			.market p {
				margin: 0;
				color: #737984;
				font-size: 11px;
				line-height: 1.6;
				letter-spacing: 0.8px;
				text-transform: uppercase;
			}

			/* --------------------------------
			   MARKET FOCUS
			-------------------------------- */

			.focus {
				background: #080a0e;
			}

			.focus-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 20px;
			}

			.focus-card {
				padding: 34px 30px;
				background: #0d1015;
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-top: 2px solid rgba(196, 157, 78, 0.55);
			}

			.focus-card h3 {
				margin: 0 0 15px;
				color: #f4f0e8;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 25px;
				font-weight: 400;
			}

			.focus-card p {
				margin: 0;
				color: #92969e;
				font-size: 15px;
				line-height: 1.75;
			}

			.disclaimer {
				max-width: 900px;
				margin: 55px 0 0;
				padding-top: 25px;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
				color: #666c75;
				font-size: 12px;
				line-height: 1.7;
			}

			/* --------------------------------
			   TESTIMONIALS
			-------------------------------- */

			.testimonials {
				background: #0b0e13;
			}

			.testimonial-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 20px;
			}

			.testimonial {
				padding: 34px;
				border: 1px solid rgba(255, 255, 255, 0.08);
				background: #0d1015;
			}

			.testimonial-mark {
				margin-bottom: 22px;
				color: #c49d4e;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 35px;
			}

			.testimonial p {
				margin: 0;
				color: #aaa9a5;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 17px;
				font-style: italic;
				line-height: 1.7;
			}

			.testimonial strong {
				display: block;
				margin-top: 25px;
				color: #f4f0e8;
				font-size: 10px;
				letter-spacing: 1.5px;
				text-transform: uppercase;
			}

			/* --------------------------------
			   CONTACT
			-------------------------------- */

			.contact {
				position: relative;
				overflow: hidden;
				text-align: center;
				background:
					linear-gradient(
						rgba(8, 10, 14, 0.94),
						rgba(8, 10, 14, 0.97)
					),
					url('/LondonBG.png');
				background-size: cover;
				background-position: center;
				border-top: 1px solid rgba(196, 157, 78, 0.35);
			}

			.contact-inner {
				position: relative;
				z-index: 1;
				max-width: 700px;
				margin: 0 auto;
			}

			.contact h2 {
				margin-bottom: 20px;
			}

			.contact p {
				margin: 0 auto 30px;
				max-width: 600px;
				color: #aaa9a5;
				font-size: 16px;
				line-height: 1.75;
			}

			/* --------------------------------
			   RESPONSIVE
			-------------------------------- */

			@media (max-width: 950px) {
				.hero-image {
					inset: 0;
					opacity: 0.48;
				}

				.hero-content {
					width: 650px;
				}

				.stats-inner {
					grid-template-columns: repeat(2, 1fr);
				}

				.stat:nth-child(2) {
					border-right: none;
				}

				.stat:nth-child(-n + 2) {
					border-bottom: 1px solid rgba(255, 255, 255, 0.12);
				}

				.about-grid {
					grid-template-columns: 1fr;
					gap: 50px;
				}

				.about-photo {
					max-width: 600px;
				}

				.market-grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}

			@media (max-width: 700px) {
				.hero {
					min-height: auto;
				}

				.hero-inner {
					min-height: auto;
					width: min(100% - 36px, 600px);
				}

				.hero-content {
					padding: 85px 0 75px;
				}

				h1 {
					font-size: clamp(50px, 14vw, 70px);
					letter-spacing: -2px;
				}

				.hero-description {
					font-size: 15px;
				}

				.stats-inner {
					grid-template-columns: 1fr 1fr;
				}

				.stat {
					padding: 20px 15px;
					gap: 12px;
				}

				.stat-number {
					font-size: 25px;
				}

				.stat-label strong {
					font-size: 9px;
					letter-spacing: 1px;
				}

				.stat-label span {
					font-size: 8px;
				}

				.section {
					padding: 75px 18px;
				}

				.section-heading {
					margin-bottom: 35px;
				}

				.market-grid {
					grid-template-columns: 1fr 1fr;
				}

				.focus-grid,
				.testimonial-grid {
					grid-template-columns: 1fr;
				}

				.about-photo,
				.about-photo img {
					height: 420px;
					min-height: 420px;
				}
			}

			@media (max-width: 450px) {
				.stats-inner {
					grid-template-columns: 1fr;
				}

				.stat {
					border-right: none;
					border-bottom: 1px solid rgba(255, 255, 255, 0.12);
				}

				.stat:last-child {
					border-bottom: none;
				}

				.market-grid {
					grid-template-columns: 1fr;
				}

				.button {
					width: 100%;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<div class="page">
			<main>
				<!-- ================================
				     HERO
				================================= -->

				<section class="hero">
					<div class="hero-image"></div>

					<div class="hero-inner">
						<div class="hero-content">
							<div class="eyebrow">Senior Financial Advisor</div>

							<h1>
								Experience.<br />
								Discipline.<br />
								<span class="gold">Market Insight.</span>
							</h1>

							<div class="hero-rule"></div>

							<p class="hero-description">
								Raymond Solomon brings 20 years of experience
								navigating global financial markets, with a
								disciplined approach to research, risk and market
								opportunity.
							</p>

							<a class="button" href="#contact">
								Request a Consultation
							</a>
						</div>
					</div>
				</section>

				<!-- ================================
				     STATS
				================================= -->

				<section class="stats">
					<div class="stats-inner">
						<div class="stat">
							<div class="stat-number">20+</div>

							<div class="stat-label">
								<strong>Years Experience</strong>
								<span>Professional Market Experience</span>
							</div>
						</div>

						<div class="stat">
							<div class="stat-number">5</div>

							<div class="stat-label">
								<strong>Market Areas</strong>
								<span>Global Markets Followed</span>
							</div>
						</div>

						<div class="stat">
							<div class="stat-number">UK</div>

							<div class="stat-label">
								<strong>Based in London</strong>
								<span>UK Financial Markets</span>
							</div>
						</div>

						<div class="stat">
							<div class="stat-number">◆</div>

							<div class="stat-label">
								<strong>Disciplined</strong>
								<span>Research Driven</span>
							</div>
						</div>
					</div>
				</section>

				<!-- ================================
				     ABOUT
				================================= -->

				<section class="section about" id="about">
					<div class="section-inner about-grid">
						<div class="about-copy">
							<div class="section-heading">
								<div class="eyebrow">About Raymond</div>

								<h2>
									Two decades of
									market experience.
								</h2>
							</div>

							<p>
								Over the past 20 years in the UK, I have developed
								a deep understanding of financial markets and the
								factors that influence investment decisions.
							</p>

							<p>
								My background includes business and finance
								education at London Business School, combined
								with years of practical experience observing
								markets through different economic cycles.
							</p>

							<p>
								My approach is built around research, discipline,
								risk awareness and a clear understanding of each
								client's objectives.
							</p>
						</div>

						<!--
							YOUR PERSONAL PHOTO GOES HERE.

							Your file should be:
							public/Picture1.png

							You can replace the src below later if you
							choose a different filename.
						-->

						<div class="about-photo">
							<img
								src="/Picture1.png"
								alt="Raymond Solomon"
							/>

							<div class="photo-caption">
								Raymond Solomon · London
							</div>
						</div>
					</div>
				</section>

				<!-- ================================
				     MARKETS
				================================= -->

				<section class="section markets" id="markets">
					<div class="section-inner">
						<div class="section-heading">
							<div class="eyebrow">Markets</div>

							<h2>Global markets I follow.</h2>

							<p class="section-intro">
								I monitor a broad range of global markets to
								understand opportunities, risks and changing
								market conditions.
							</p>
						</div>

						<div class="market-grid">
							<div class="market">
								<div class="market-number">01</div>
								<h3>Stocks</h3>
								<p>Equities &amp; Companies</p>
							</div>

							<div class="market">
								<div class="market-number">02</div>
								<h3>Commodities</h3>
								<p>Global Resources</p>
							</div>

							<div class="market">
								<div class="market-number">03</div>
								<h3>Forex</h3>
								<p>Currency Markets</p>
							</div>

							<div class="market">
								<div class="market-number">04</div>
								<h3>Metals</h3>
								<p>Precious Metals</p>
							</div>

							<div class="market">
								<div class="market-number">05</div>
								<h3>Crypto</h3>
								<p>Digital Assets</p>
							</div>
						</div>
					</div>
				</section>

				<!-- ================================
				     MARKET FOCUS
				================================= -->

				<section class="section focus">
					<div class="section-inner">
						<div class="section-heading">
							<div class="eyebrow">Market Focus</div>

							<h2>Experience across market cycles.</h2>
						</div>

						<div class="focus-grid">
							<div class="focus-card">
								<h3>Equity Markets</h3>

								<p>
									Research-driven analysis of companies,
									sectors, earnings and broader market
									conditions.
								</p>
							</div>

							<div class="focus-card">
								<h3>Earnings Season</h3>

								<p>
									Focused attention on corporate earnings,
									guidance, expectations and market
									reactions.
								</p>
							</div>

							<div class="focus-card">
								<h3>Economic Data</h3>

								<p>
									Monitoring major economic releases and
									their potential influence on currencies
									and markets.
								</p>
							</div>
						</div>

						<p class="disclaimer">
							Information presented on this website is for general
							informational purposes only and does not constitute
							investment advice or a recommendation to buy or sell
							any financial instrument. Past performance is not
							indicative of future results.
						</p>
					</div>
				</section>

				<!-- ================================
				     TESTIMONIALS
				================================= -->

				<section class="section testimonials">
					<div class="section-inner">
						<div class="section-heading">
							<div class="eyebrow">Client Experience</div>

							<h2>What clients say.</h2>

							<p class="section-intro">
								Client feedback will be published here with
								permission.
							</p>
						</div>

						<div class="testimonial-grid">
							<div class="testimonial">
								<div class="testimonial-mark">“</div>

								<p>
									[Replace this with a genuine client
									testimonial approved for publication.]
								</p>

								<strong>— Verified Client</strong>
							</div>

							<div class="testimonial">
								<div class="testimonial-mark">“</div>

								<p>
									[Replace this with a genuine client
									testimonial approved for publication.]
								</p>

								<strong>— Verified Client</strong>
							</div>

							<div class="testimonial">
								<div class="testimonial-mark">“</div>

								<p>
									[Replace this with a genuine client
									testimonial approved for publication.]
								</p>

								<strong>— Verified Client</strong>
							</div>
						</div>
					</div>
				</section>

				<!-- ================================
				     CONTACT
				================================= -->

				<section class="section contact" id="contact">
					<div class="contact-inner">
						<div class="eyebrow">Private Consultation</div>

						<h2>Let's start a conversation.</h2>

						<p>
							If you would like to discuss your financial goals
							or learn more about my approach, get in touch.
						</p>

						<a class="button" href="/about">
							Contact Raymond
						</a>
					</div>
				</section>
			</main>

