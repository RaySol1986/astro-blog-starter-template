---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>Raymond Solomon | Senior Financial Advisor</title>

		<meta
			name="description"
			content="Raymond Solomon — Senior Financial Advisor with 20 years of experience navigating global financial markets."
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="hero">
				<div class="hero-image"></div>

				<div class="hero-overlay"></div>

				<div class="hero-content">
					<div class="eyebrow">Senior Financial Advisor</div>

					<h1>
						<span>Experience.</span>
						<span>Discipline.</span>
						<span class="gold">Market Insight.</span>
					</h1>

					<div class="hero-line"></div>

					<p class="hero-description">
						Raymond Solomon brings 20 years of experience navigating global
						financial markets, with a disciplined approach to research, risk
						and market opportunity.
					</p>

					<a class="hero-button" href="/contact">
						Request a Consultation
					</a>
				</div>
			</section>

			<!-- STATS -->
			<section class="stats">
				<div class="stats-inner">
					<div class="stat">
						<div class="stat-number">20+</div>

						<div>
							<strong>Years<br />Experience</strong>
							<span>Professional<br />Market Experience</span>
						</div>
					</div>

					<div class="stat">
						<div class="stat-number">5</div>

						<div>
							<strong>Market<br />Areas</strong>
							<span>Global<br />Markets</span>
						</div>
					</div>

					<div class="stat">
						<div class="stat-number">UK</div>

						<div>
							<strong>Based in<br />London</strong>
							<span>UK<br />Financial Markets</span>
						</div>
					</div>

					<div class="stat">
						<div class="stat-diamond"></div>

						<div>
							<strong>Disciplined</strong>
							<span>Research<br />Driven</span>
						</div>
					</div>
				</div>
			</section>

			<!-- ABOUT / RAYMOND -->
			<section class="about-preview">
				<div class="about-inner">
					<div class="about-copy">
						<div class="eyebrow">About Raymond</div>

						<h2>
							Two decades of
							<span>market experience.</span>
						</h2>

						<p>
							Over the past 20 years in the UK, I have developed a deep
							understanding of financial markets and the factors that
							influence investment decisions.
						</p>

						<p>
							My background includes business and finance education at
							London Business School, combined with years of practical
							experience observing markets through different economic
							cycles.
						</p>

						<p>
							My approach is built around research, discipline, risk
							awareness and a clear understanding of each client's
							objectives.
						</p>

						<a class="about-link" href="/about">
							More About Raymond
							<span>→</span>
						</a>
					</div>

					<!-- RAYMOND PHOTO -->
					<div class="portrait-area">
						<div class="portrait-frame">
							<div class="portrait-inner">
								<img
									src="/Picture4RS.png"
									alt="Raymond Solomon"
								/>

								<div class="portrait-caption">
									<strong>Raymond Solomon</strong>
									<span>Senior Financial Advisor</span>
									<small>London</small>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- MARKETS -->
			<section class="markets" id="markets">
				<div class="markets-inner">
					<div class="eyebrow">Market Perspective</div>

					<h2>
						Research-led thinking for
						<span>changing markets.</span>
					</h2>

					<div class="market-grid">
						<div class="market-card">
							<div class="market-number">01</div>

							<h3>Global Markets</h3>

							<p>
								Understanding the forces shaping international financial
								markets and investment opportunities.
							</p>
						</div>

						<div class="market-card">
							<div class="market-number">02</div>

							<h3>Risk Awareness</h3>

							<p>
								A disciplined approach to identifying risk and making
								informed decisions through different market cycles.
							</p>
						</div>

						<div class="market-card">
							<div class="market-number">03</div>

							<h3>Market Insight</h3>

							<p>
								Research and experience combined to provide a clearer view
								of market conditions and potential opportunities.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- CONTACT CTA -->
			<section class="contact-cta" id="contact">
				<div class="contact-inner">
					<div>
						<div class="eyebrow">Start a Conversation</div>

						<h2>
							Let's discuss your
							<span>financial objectives.</span>
						</h2>

						<p class="contact-description">
							Send a private message through the contact form and
							I'll get back to you.
						</p>
					</div>

					<a class="hero-button" href="/contact">
						Request a Consultation
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(html) {
		background: #080a0e;
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #080a0e;
		color: #f4f0e8;
		font-family:
			Arial,
			Helvetica,
			sans-serif;
	}

	:global(*) {
		box-sizing: border-box;
	}

	/* HERO */

	.hero {
		position: relative;
		min-height: 650px;
		overflow: hidden;
		background: #080a0e;
		border-bottom: 1px solid rgba(196, 157, 78, 0.5);
	}

	.hero-image {
		position: absolute;
		inset: 0;
		background-image: url('/LondonBG.png');
		background-size: cover;
		background-position: center center;
		opacity: 0.72;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;

		background:
			linear-gradient(
				90deg,
				#080a0e 0%,
				rgba(8, 10, 14, 0.97) 27%,
				rgba(8, 10, 14, 0.82) 48%,
				rgba(8, 10, 14, 0.22) 78%,
				rgba(8, 10, 14, 0.15) 100%
			);
	}

	.hero-content {
		position: relative;
		z-index: 2;

		width: min(1250px, calc(100% - 48px));
		min-height: 650px;

		margin: 0 auto;

		display: flex;
		flex-direction: column;
		justify-content: center;

		padding: 80px 0;
	}

	.eyebrow {
		margin-bottom: 22px;

		color: #c49d4e;

		font-size: 12px;
		font-weight: 700;

		letter-spacing: 3px;
		text-transform: uppercase;
	}

	h1,
	h2 {
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 400;
	}

	h1 {
		max-width: 760px;

		margin: 0;

		font-size: clamp(58px, 6vw, 92px);
		line-height: 0.94;

		letter-spacing: -4px;
	}

	h1 span {
		display: block;
	}

	.gold {
		color: #c49d4e;
	}

	.hero-line {
		width: 52px;
		height: 2px;

		margin: 34px 0 25px;

		background: #c49d4e;
	}

	.hero-description {
		max-width: 560px;

		margin: 0;

		color: #d8d3ca;

		font-size: 16px;
		line-height: 1.8;
	}

	.hero-button {
		display: inline-flex;

		align-items: center;
		justify-content: center;

		width: fit-content;

		margin-top: 32px;
		padding: 16px 30px;

		background: #c49d4e;
		color: #080a0e;

		text-decoration: none;

		font-size: 12px;
		font-weight: 700;

		letter-spacing: 1.5px;
		text-transform: uppercase;

		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}

	.hero-button:hover {
		background: #d5b263;
		transform: translateY(-2px);
	}

	/* STATS */

	.stats {
		background: #080a0e;

		border-bottom: 1px solid rgba(196, 157, 78, 0.4);
	}

	.stats-inner {
		width: min(1050px, calc(100% - 48px));

		margin: 0 auto;

		display: grid;

		grid-template-columns: repeat(4, 1fr);
	}

	.stat {
		min-height: 110px;

		padding: 22px 28px;

		display: flex;

		align-items: center;

		gap: 20px;

		border-right: 1px solid rgba(255, 255, 255, 0.12);
	}

	.stat:last-child {
		border-right: 0;
	}

	.stat-number {
		flex-shrink: 0;

		color: #c49d4e;

		font-family: Georgia, 'Times New Roman', serif;

		font-size: 28px;
	}

	.stat strong {
		display: block;

		color: #f4f0e8;

		font-size: 11px;
		line-height: 1.45;

		letter-spacing: 1.5px;
		text-transform: uppercase;
	}

	.stat span {
		display: block;

		margin-top: 7px;

		color: #777d87;

		font-size: 9px;
		line-height: 1.5;

		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.stat-diamond {
		width: 13px;
		height: 13px;

		flex-shrink: 0;

		background: #c49d4e;

		transform: rotate(45deg);
	}

	/* ABOUT */

	.about-preview {
		background: #080a0e;

		padding: 130px 0;
	}

	.about-inner {
		width: min(1050px, calc(100% - 48px));

		margin: 0 auto;

		display: grid;

		grid-template-columns: minmax(0, 1fr) 430px;

		align-items: center;

		gap: 110px;
	}

	.about-copy {
		max-width: 590px;
	}

	.about-copy .eyebrow {
		margin-bottom: 25px;
	}

	.about-copy h2 {
		margin: 0 0 42px;

		font-size: clamp(48px, 5vw, 72px);

		line-height: 0.98;

		letter-spacing: -3px;
	}

	.about-copy h2 span {
		display: block;

		color: #c49d4e;
	}

	.about-copy p {
		max-width: 540px;

		margin: 0 0 24px;

		color: #c9c5bd;

		font-size: 16px;
		line-height: 1.85;
	}

	.about-link {
		display: inline-flex;

		align-items: center;

		gap: 18px;

		margin-top: 18px;

		color: #c49d4e;

		text-decoration: none;

		font-size: 11px;
		font-weight: 700;

		letter-spacing: 1.8px;
		text-transform: uppercase;
	}

	.about-link span {
		font-size: 18px;

		transition: transform 0.2s ease;
	}

	.about-link:hover span {
		transform: translateX(5px);
	}

	/* PORTRAIT */

	.portrait-area {
		display: flex;

		justify-content: center;
	}

	.portrait-frame {
		position: relative;

		width: 360px;

		padding: 10px;

		border: 1px solid rgba(196, 157, 78, 0.45);
	}

	.portrait-frame::before {
		content: '';

		position: absolute;

		top: -9px;
		left: -9px;
		right: 9px;
		bottom: 9px;

		border: 1px solid rgba(196, 157, 78, 0.18);

		pointer-events: none;
	}

	.portrait-inner {
		position: relative;

		aspect-ratio: 3 / 4;

		overflow: hidden;

		background: #11151c;
	}

	.portrait-inner img {
		width: 100%;
		height: 100%;

		display: block;

		object-fit: cover;
		object-position: center top;
	}

	.portrait-caption {
		position: absolute;

		left: 18px;
		right: 18px;
		bottom: 18px;

		padding: 18px 20px;

		background: rgba(8, 10, 14, 0.92);

		border-left: 2px solid #c49d4e;
	}

	.portrait-caption strong {
		display: block;

		color: #f4f0e8;

		font-size: 11px;

		letter-spacing: 2px;

		text-transform: uppercase;
	}

	.portrait-caption span {
		display: block;

		margin-top: 6px;

		color: #a6a19a;

		font-size: 9px;

		letter-spacing: 1.5px;

		text-transform: uppercase;
	}

	.portrait-caption small {
		display: block;

		margin-top: 8px;

		color: #c49d4e;

		font-size: 9px;

		letter-spacing: 2px;

		text-transform: uppercase;
	}

	/* MARKETS */

	.markets {
		padding: 120px 0;

		background: #0b0e13;

		border-top: 1px solid rgba(196, 157, 78, 0.2);

		border-bottom: 1px solid rgba(196, 157, 78, 0.2);
	}

	.markets-inner {
		width: min(1050px, calc(100% - 48px));

		margin: 0 auto;
	}

	.markets h2 {
		max-width: 720px;

		margin: 0 0 65px;

		font-size: clamp(46px, 5vw, 70px);

		line-height: 1;

		letter-spacing: -3px;
	}

	.markets h2 span {
		color: #c49d4e;
	}

	.market-grid {
		display: grid;

		grid-template-columns: repeat(3, 1fr);

		border-top: 1px solid rgba(196, 157, 78, 0.3);
	}

	.market-card {
		min-height: 280px;

		padding: 30px;

		border-right: 1px solid rgba(255, 255, 255, 0.1);
	}

	.market-card:last-child {
		border-right: 0;
	}

	.market-number {
		color: #c49d4e;

		font-family: Georgia, 'Times New Roman', serif;

		font-size: 18px;
	}

	.market-card h3 {
		margin: 45px 0 18px;

		color: #f4f0e8;

		font-family: Georgia, 'Times New Roman', serif;

		font-size: 25px;

		font-weight: 400;
	}

	.market-card p {
		margin: 0;

		color: #9c9fa5;

		font-size: 14px;

		line-height: 1.8;
	}

	/* CONTACT */

	.contact-cta {
		padding: 110px 0;

		background: #080a0e;
	}

	.contact-inner {
		width: min(1050px, calc(100% - 48px));

		margin: 0 auto;

		display: flex;

		align-items: center;

		justify-content: space-between;

		gap: 60px;
	}

	.contact-inner h2 {
		max-width: 680px;

		margin: 0;

		font-size: clamp(42px, 5vw, 68px);

		line-height: 1;

		letter-spacing: -3px;
	}

	.contact-inner h2 span {
		color: #c49d4e;
	}

	.contact-description {
		max-width: 520px;

		margin: 22px 0 0;

		color: #9c9fa5;

		font-size: 15px;

		line-height: 1.8;
	}

	.contact-inner .hero-button {
		flex-shrink: 0;

		margin-top: 0;
	}

	/* TABLET */

	@media (max-width: 950px) {
		.about-inner {
			grid-template-columns: 1fr 360px;

			gap: 60px;
		}

		.stats-inner {
			grid-template-columns: repeat(2, 1fr);
		}

		.stat:nth-child(2) {
			border-right: 0;
		}

		.stat:nth-child(-n + 2) {
			border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		}

		.contact-inner {
			flex-direction: column;

			align-items: flex-start;
		}

		.contact-inner .hero-button {
			margin-top: 10px;
		}
	}

	/* MOBILE */

	@media (max-width: 700px) {
		.hero {
			min-height: 680px;
		}

		.hero-content {
			width: min(100% - 36px, 600px);

			min-height: 680px;

			padding: 70px 0;
		}

		.hero-image {
			background-position: 65% center;
		}

		.hero-overlay {
			background:
				linear-gradient(
					90deg,
					#080a0e 0%,
					rgba(8, 10, 14, 0.92) 65%,
					rgba(8, 10, 14, 0.55) 100%
				);
		}

		h1 {
			font-size: clamp(50px, 14vw, 72px);

			letter-spacing: -3px;
		}

		.hero-description {
			font-size: 15px;
		}

		.stats-inner {
			width: 100%;

			grid-template-columns: 1fr 1fr;
		}

		.stat {
			padding: 22px 16px;

			gap: 12px;
		}

		.stat-number {
			font-size: 24px;
		}

		.about-preview {
			padding: 90px 0;
		}

		.about-inner {
			width: min(100% - 36px, 600px);

			grid-template-columns: 1fr;

			gap: 65px;
		}

		.about-copy h2 {
			font-size: 52px;
		}

		.portrait-area {
			justify-content: center;
		}

		.portrait-frame {
			width: min(100%, 350px);
		}

		.markets {
			padding: 90px 0;
		}

		.markets-inner {
			width: min(100% - 36px, 600px);
		}

		.markets h2 {
			font-size: 50px;
		}

		.market-grid {
			grid-template-columns: 1fr;
		}

		.market-card {
			border-right: 0;

			border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		}

		.market-card:last-child {
			border-bottom: 0;
		}

		.contact-cta {
			padding: 90px 0;
		}

		.contact-inner {
			width: min(100% - 36px, 600px);
		}

		.contact-inner h2 {
			font-size: 48px;
		}
	}

	@media (max-width: 450px) {
		.stats-inner {
			grid-template-columns: 1fr;
		}

		.stat {
			border-right: 0;

			border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		}

		.stat:last-child {
			border-bottom: 0;
		}

		.about-copy h2,
		.markets h2,
		.contact-inner h2 {
			font-size: 44px;
		}
	}
</style>
