---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<style>
			:global(html) {
				scroll-behavior: smooth;
				background: #080a0e;
			}

			:global(body) {
				margin: 0;
				font-family: Arial, Helvetica, sans-serif;
				color: #f4f0e8;
				background: #080a0e;
			}

			.hero {
				position: relative;
				min-height: 540px;
				overflow: hidden;
				background: #080a0e;
				border-bottom: 1px solid rgba(196, 157, 78, 0.65);
			}

			.hero-background {
				position: absolute;
				inset: 0;

				background-image:
					linear-gradient(
						90deg,
						rgba(8, 10, 14, 1) 0%,
						rgba(8, 10, 14, 0.98) 30%,
						rgba(8, 10, 14, 0.88) 45%,
						rgba(8, 10, 14, 0.48) 65%,
						rgba(8, 10, 14, 0.15) 100%
					),
					url('/LondonBG.png');

				background-size: cover;
				background-position: center;
				background-repeat: no-repeat;
			}

			.hero-content {
				position: relative;
				z-index: 2;

				max-width: 1250px;
				margin: 0 auto;
				padding: 60px 24px 70px;
			}

			.eyebrow {
				color: #c49d4e;
				font-size: 12px;
				font-weight: 600;
				letter-spacing: 2px;
				text-transform: uppercase;
				margin-bottom: 18px;
			}

			.hero h1 {
				max-width: 650px;
				margin: 0;

				font-family: Georgia, "Times New Roman", serif;
				font-size: clamp(58px, 6vw, 82px);
				font-weight: 400;
				line-height: 0.98;
				letter-spacing: -2px;
				color: #f4f0e8;
			}

			.hero h1 span {
				display: block;
			}

			.hero h1 .gold {
				color: #c49d4e;
			}

			.hero-line {
				width: 55px;
				height: 2px;
				background: #c49d4e;
				margin: 28px 0 24px;
			}

			.hero p {
				max-width: 510px;
				margin: 0 0 30px;

				font-size: 16px;
				line-height: 1.7;
				color: #d1cec8;
			}

			.button {
				display: inline-block;

				background: #c49d4e;
				color: #080a0e;

				padding: 16px 30px;

				border: 1px solid #c49d4e;
				border-radius: 2px;

				text-decoration: none;
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 1.5px;
				text-transform: uppercase;

				transition:
					background 0.2s ease,
					color 0.2s ease;
			}

			.button:hover {
				background: transparent;
				color: #c49d4e;
			}

			/* ================================
			   STATISTICS BAR
			================================ */

			.stats {
				background: #080a0e;
				border-bottom: 1px solid rgba(196, 157, 78, 0.35);
			}

			.stats-inner {
				max-width: 1250px;
				margin: 0 auto;

				display: grid;
				grid-template-columns: repeat(4, 1fr);

				padding: 24px;
			}

			.stat {
				display: flex;
				align-items: center;
				gap: 18px;

				padding: 5px 35px;

				border-right: 1px solid rgba(255, 255, 255, 0.12);
			}

			.stat:last-child {
				border-right: none;
			}

			.stat-number {
				font-family: Georgia, "Times New Roman", serif;
				font-size: 32px;
				color: #c49d4e;
				white-space: nowrap;
			}

			.stat-label {
				color: #f4f0e8;
				font-size: 12px;
				font-weight: 600;
				letter-spacing: 1.5px;
				text-transform: uppercase;
			}

			.stat-subtitle {
				margin-top: 5px;
				color: #777d86;
				font-size: 9px;
				letter-spacing: 1px;
				text-transform: uppercase;
			}

			/* ================================
			   GENERAL SECTIONS
			================================ */

			.section {
				padding: 90px 24px;
				background: #080a0e;
			}

			.section-dark {
				background: #0b0e13;
			}

			.section-inner {
				max-width: 1050px;
				margin: 0 auto;
			}

			h2 {
				font-family: Georgia, "Times New Roman", serif;
				font-size: clamp(38px, 5vw, 58px);
				font-weight: 400;
				line-height: 1.05;
				letter-spacing: -1px;
				color: #f4f0e8;
				margin: 0 0 22px;
			}

			.section-intro {
				max-width: 680px;
				font-size: 17px;
				line-height: 1.8;
				color: #aaaeb5;
				margin: 0 0 45px;
			}

			/* ================================
			   ABOUT
			================================ */

			.about-grid {
				display: grid;
				grid-template-columns: 1.2fr 0.8fr;
				gap: 80px;
				align-items: center;
			}

			.about-copy p {
				font-size: 16px;
				line-height: 1.8;
				color: #b9bcc2;
			}

			.experience-box {
				padding: 45px;
				background: #0d1016;
				border: 1px solid rgba(196, 157, 78, 0.3);
				position: relative;
			}

			.experience-box::before {
				content: "";
				position: absolute;
				top: 0;
				left: 0;
				width: 60px;
				height: 2px;
				background: #c49d4e;
			}

			.experience-number {
				font-family: Georgia, "Times New Roman", serif;
				font-size: 72px;
				line-height: 1;
				color: #c49d4e;
				margin-bottom: 15px;
			}

			.experience-box strong {
				color: #f4f0e8;
				font-size: 14px;
				letter-spacing: 1px;
				text-transform: uppercase;
			}

			.experience-box p {
				color: #858a93;
				line-height: 1.7;
				margin-top: 20px;
			}

			/* ================================
			   MARKETS
			================================ */

			.markets {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1px;
				margin-top: 40px;
				border: 1px solid rgba(255, 255, 255, 0.08);
				background: rgba(255, 255, 255, 0.08);
			}

			.market {
				padding: 35px 15px;
				background: #0b0e13;
				text-align: center;

				color: #d9d5cd;
				font-size: 12px;
				font-weight: 600;
				letter-spacing: 1.5px;
				text-transform: uppercase;

				transition:
					background 0.2s ease,
					color 0.2s ease;
			}

			.market:hover {
				background: #12161d;
				color: #c49d4e;
			}

			/* ================================
			   MARKET FOCUS
			================================ */

			.highlights {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 20px;
				margin-top: 45px;
			}

			.highlight {
				background: #0d1016;
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-top: 2px solid #c49d4e;
				padding: 32px;
			}

			.highlight h3 {
				font-family: Georgia, "Times New Roman", serif;
				font-size: 24px;
				font-weight: 400;
				color: #f4f0e8;
				margin: 0 0 15px;
			}

			.highlight p {
				line-height: 1.7;
				color: #9297a0;
			}

			/* ================================
			   TESTIMONIALS
			================================ */

			.testimonials {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 20px;
				margin-top: 40px;
			}

			.testimonial {
				background: #0d1016;
				border: 1px solid rgba(255, 255, 255, 0.08);
				padding: 30px;
			}

			.testimonial p {
				line-height: 1.8;
				color: #a7abb2;
				font-style: italic;
			}

			.testimonial strong {
				display: block;
				margin-top: 22px;
				color: #c49d4e;
				font-size: 11px;
				letter-spacing: 1px;
				text-transform: uppercase;
			}

			/* ================================
			   DISCLAIMER
			================================ */

			.disclaimer {
				max-width: 800px;
				margin-top: 55px;
				color: #646a73;
				font-size: 11px;
				line-height: 1.7;
			}

			/* ================================
			   CONTACT
			================================ */

			.contact {
				text-align: center;
				background: #0d1016;
				border-top: 1px solid rgba(196, 157, 78, 0.25);
			}

			.contact h2 {
				color: #f4f0e8;
			}

			.contact p {
				max-width: 650px;
				margin: 0 auto 30px;
				line-height: 1.8;
				color: #a7abb2;
			}

			/* ================================
			   RESPONSIVE
			================================ */

			@media (max-width: 900px) {
				.about-grid {
					grid-template-columns: 1fr;
					gap: 45px;
				}

				.highlights,
				.testimonials {
					grid-template-columns: 1fr;
				}

				.stats-inner {
					grid-template-columns: repeat(2, 1fr);
				}

				.stat {
					padding: 20px;
				}

				.stat:nth-child(2) {
					border-right: none;
				}

				.stat:nth-child(-n + 2) {
					border-bottom: 1px solid rgba(255, 255, 255, 0.12);
				}
			}

			@media (max-width: 650px) {
				.hero {
					min-height: 600px;
				}

				.hero-background {
					background-image:
						linear-gradient(
							180deg,
							rgba(8, 10, 14, 0.9) 0%,
							rgba(8, 10, 14, 0.78) 50%,
							rgba(8, 10, 14, 0.97) 100%
						),
						url('/LondonBG.png');

					background-position: center;
				}

				.hero-content {
					padding: 65px 24px;
				}

				.hero h1 {
					font-size: clamp(48px, 12vw, 68px);
				}

				.stats-inner {
					grid-template-columns: 1fr;
				}

				.stat,
				.stat:nth-child(2) {
					border-right: none;
					border-bottom: 1px solid rgba(255, 255, 255, 0.12);
				}

				.stat:last-child {
					border-bottom: none;
				}

				.markets {
					grid-template-columns: repeat(2, 1fr);
				}

				.section {
					padding: 70px 24px;
				}

				.experience-box {
					padding: 30px;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>

			<!-- HERO -->
			<section class="hero">
				<div class="hero-background"></div>

				<div class="hero-content">
					<div class="eyebrow">Senior Financial Advisor</div>

					<h1>
						<span>Experience.</span>
						<span>Discipline.</span>
						<span class="gold">Market Insight.</span>
					</h1>

					<div class="hero-line"></div>

					<p>
						Raymond Solomon brings 20 years of experience navigating
						global financial markets, with a disciplined approach to
						research, risk and market opportunity.
					</p>

					<a class="button" href="#contact">
						Request a Consultation
					</a>
				</div>
			</section>

			<!-- STATS -->
			<section class="stats">
				<div class="stats-inner">

					<div class="stat">
						<div class="stat-number">20+</div>

						<div>
							<div class="stat-label">Years Experience</div>
							<div class="stat-subtitle">
								Professional market experience
							</div>
						</div>
					</div>

					<div class="stat">
						<div class="stat-number">5</div>

						<div>
							<div class="stat-label">Market Areas</div>
							<div class="stat-subtitle">
								Global markets followed
							</div>
						</div>
					</div>

					<div class="stat">
						<div class="stat-number">UK</div>

						<div>
							<div class="stat-label">Based in London</div>
							<div class="stat-subtitle">
								UK financial markets
							</div>
						</div>
					</div>

					<div class="stat">
						<div class="stat-number">◆</div>

						<div>
							<div class="stat-label">Disciplined</div>
							<div class="stat-subtitle">
								Research driven
							</div>
						</div>
					</div>

				</div>
			</section>

			<!-- ABOUT -->
			<section class="section">
				<div class="section-inner about-grid">

					<div class="about-copy">
						<div class="eyebrow">About Raymond</div>

						<h2>
							Two decades of market experience.
						</h2>

						<p>
							Over the past 20 years in the UK, I have developed a
							deep understanding of financial markets and the factors
							that influence investment decisions.
						</p>

						<p>
							My background includes business and finance education at
							London Business School, combined with years of practical
							experience observing markets through different economic
							cycles.
						</p>

						<p>
							My approach is built around research, discipline,
							risk awareness and a clear understanding of each
							client's objectives.
						</p>
					</div>

					<div class="experience-box">
						<div class="experience-number">20+</div>

						<strong>
							Years of professional experience
						</strong>

						<p>
							UK-based experience across multiple market cycles,
							with a focus on disciplined analysis and informed
							decision-making.
						</p>
					</div>

				</div>
			</section>

			<!-- MARKETS -->
			<section class="section section-dark" id="markets">
				<div class="section-inner">

					<div class="eyebrow">Markets</div>

					<h2>Global markets I follow.</h2>

					<p class="section-intro">
						I monitor a broad range of global markets to understand
						opportunities, risks and changing market conditions.
					</p>

					<div class="markets">
						<div class="market">Stocks</div>
						<div class="market">Commodities</div>
						<div class="market">Forex</div>
						<div class="market">Metals</div>
						<div class="market">Crypto</div>
					</div>

				</div>
			</section>

			<!-- MARKET FOCUS -->
			<section class="section">
				<div class="section-inner">

					<div class="eyebrow">Market Focus</div>

					<h2>
						Experience across market cycles.
					</h2>

					<div class="highlights">

						<div class="highlight">
							<h3>Equity Markets</h3>

							<p>
								Research-driven analysis of companies, sectors,
								earnings and broader market conditions.
							</p>
						</div>

						<div class="highlight">
							<h3>Earnings Season</h3>

							<p>
								Focused attention on corporate earnings,
								guidance, expectations and market reactions.
							</p>
						</div>

						<div class="highlight">
							<h3>Economic Data</h3>

							<p>
								Monitoring major economic releases and their
								potential influence on currencies and markets.
							</p>
						</div>

					</div>

					<p class="disclaimer">
						Information presented on this website is for general
						informational purposes only and does not constitute
						investment advice or a recommendation to buy or sell
						any financial instrument. Past performance is not
						indicative of future results.
					</p>

				</div>
			</section>

			<!-- TESTIMONIALS -->
			<section class="section section-dark">
				<div class="section-inner">

					<div class="eyebrow">Client Experience</div>

					<h2>What clients say.</h2>

					<p class="section-intro">
						Client feedback will be published here with permission.
					</p>

					<div class="testimonials">

						<div class="testimonial">
							<p>
								“[Replace this with a genuine client testimonial
								approved for publication.]”
							</p>

							<strong>Verified Client</strong>
						</div>

						<div class="testimonial">
							<p>
								“[Replace this with a genuine client testimonial
								approved for publication.]”
							</p>

							<strong>Verified Client</strong>
						</div>

						<div class="testimonial">
							<p>
								“[Replace this with a genuine client testimonial
								approved for publication.]”
							</p>

							<strong>Verified Client</strong>
						</div>

					</div>

				</div>
			</section>

			<!-- CONTACT -->
			<section class="section contact" id="contact">
				<div class="section-inner">

					<div class="eyebrow">Private Consultation</div>

					<h2>
						Let's start a conversation.
					</h2>

					<p>
						If you would like to discuss your financial goals
						or learn more about my approach, get in touch.
					</p>

					<a class="button" href="/about">
						Contact Raymond
					</a>

				</div>
			</section>

		</main>

		<Footer />
	</body>
</html>
